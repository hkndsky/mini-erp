# Postgres connection string (Prisma + API)
DATABASE_URL=postgresql://erp:erp_pass@127.0.0.1:5432/erp

# Port the API listens on
PORT=4000

# Must be set in production; a dev fallback is used when unset
JWT_SECRET=dev-insecure-jwt-secret

# Set to "false" to disable the background partner/legacy sync jobs
SYNC_ENABLED=false

# Comma-separated allowed browser origins (unset = allow all)
WEB_ORIGIN=http://localhost:5173

# Mock partner service (apps/mock-partner)
PARTNER_API_URL=http://127.0.0.1:4010
PARTNER_TIMEOUT_MS=3000
PARTNER_RETRIES=3
PARTNER_SYNC_CRON=*/10 * * * *
LEGACY_SYNC_CRON=*/30 * * * *

# Reconciliation source priority (highest first)
RECON_SOURCE_PRIORITY=CSV,PARTNER_API,LEGACY
